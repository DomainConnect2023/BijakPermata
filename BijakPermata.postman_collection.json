{
  "info": {
    "_postman_id": "b1a3c2d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "BijakPermata API",
    "description": "All backend endpoints called by the BijakPermata mobile app (reverse-engineered from src/services/*.ts).\n\nNotes:\n- There is NO Authorization/Bearer token anywhere in this app. Every request only sends `Content-Type: application/json`.\n- The real base URL is resolved at runtime via the external `Bootstrap` request in this collection (GetIP). Set the `baseUrl` collection variable to whatever that returns, or to the fallback `https://bijakpermatadev.domainsb.com.my`.\n- Most `/Api/*` endpoints return an envelope `{ isSuccess, message, data }`. The `/Report/*` endpoints use their own ad-hoc shapes (e.g. `{ date, data }`, `{ startDate, endDate, data }`) and just check `response.ok`.\n- `GetPageAccess` is the one exception that returns a bare boolean, not an envelope.\n- Each report has a sibling `...Report` endpoint that returns a printable HTML page (opened in-browser for viewing/printing/export), not JSON.\n- `GetMarginProfit` / `GetMarginProfitReport`: the backend's `dateTo`/`dateFrom` query params are swapped relative to their names — `dateTo` is actually the range start and `dateFrom` is the range end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://bijakpermatadev.domainsb.com.my", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "accessId", "value": "1", "type": "string" },
    { "key": "date", "value": "2026-11-03", "type": "string" },
    { "key": "startDate", "value": "2026-11-01", "type": "string" },
    { "key": "endDate", "value": "2026-11-03", "type": "string" },
    { "key": "year", "value": "2026", "type": "string" },
    { "key": "month", "value": "11", "type": "string" },
    { "key": "currency", "value": "USD", "type": "string" },
    { "key": "glCode", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Bootstrap",
      "item": [
        {
          "name": "Get Server IP (license/host resolver)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "https://domainmobile.domainsb.com.my/Api/GetIP?packageName=com.bijakpermata&branch=",
              "protocol": "https",
              "host": ["domainmobile", "domainsb", "com", "my"],
              "path": ["Api", "GetIP"],
              "query": [
                { "key": "packageName", "value": "com.bijakpermata" },
                { "key": "branch", "value": "" }
              ]
            },
            "description": "External host-resolution service (not the app backend). Returns `{ isSuccess, ipAddress }`. The app uses `ipAddress` as the base URL for every request below; falls back to the `baseUrl` variable's default if this fails."
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserCode\": \"USER01\",\n  \"Password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Api/Login",
              "host": ["{{baseUrl}}"],
              "path": ["Api", "Login"]
            },
            "description": "Response: `{ isSuccess, message, data: { userId, userName, code } }`. No token is returned or stored; the app just keeps this in memory for the session."
          }
        }
      ]
    },
